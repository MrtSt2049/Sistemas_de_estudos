# Copie para backend/.env e preencha. NUNCA versione o .env.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Supabase: Connect > Session pooler (porta 5432). Codifique caracteres especiais da senha.
DATABASE_URL=postgresql://postgres.[REF]:[SENHA]@[POOLER-HOST]:5432/postgres
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Somente em producao (ex.: .exemplo.com); vazio em local
COOKIE_DOMAIN=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
ALLOW_REGISTRATION=false
LOG_LEVEL=INFO
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY e SUPABASE_STORAGE_BUCKET: somente se D-02 adotar Supabase Storage (so no backend).
